<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jamthebest.Morph</id>
  <replaces>
    <id>dev.jam.Morph</id>
  </replaces>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Morph</name>
  <summary>A dynamic island for the COSMIC desktop</summary>
  <summary xml:lang="es">Una isla dinámica para el escritorio COSMIC</summary>
  <developer id="io.github.jamthebest">
    <name>Javier Midence</name>
  </developer>
  <description>
    <p>Morph is a dynamic island that lives at the top of your COSMIC desktop. It expands to show media playback, notifications, calendar, a file shelf, workspaces and developer tools, and collapses out of the way when you are done.</p>
    <p xml:lang="es">Morph es una isla dinámica que vive en la parte superior de tu escritorio COSMIC. Se expande para mostrar la reproducción multimedia, notificaciones, calendario, una repisa de archivos, escritorios y herramientas de desarrollo, y se contrae cuando terminas.</p>
  </description>
  <launchable type="desktop-id">io.github.jamthebest.Morph.desktop</launchable>
  <url type="homepage">https://github.com/jamthebest/morph</url>
  <url type="vcs-browser">https://github.com/jamthebest/morph</url>
